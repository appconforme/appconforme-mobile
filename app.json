{
  "expo": {
    "name": "AppConforme",
    "slug": "appconforme-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "appconforme",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appconforme.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.appconforme.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O AppConforme precisa acessar suas fotos para anexar evidências.",
          "cameraPermission": "O AppConforme precisa da câmera para registrar evidências em campo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1"
    }
  }
}
